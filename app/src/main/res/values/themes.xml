<?xml version="1.0" encoding="utf-8"?>
<!--
    themes.xml
    Material Design 3 theme for Student Expense Tracker.
    Uses the navy blue + teal palette defined in colors.xml.
-->
<resources>
    <!-- Base application theme -->
    <style name="Theme.StudentExpenseTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorTextOnPrimary</item>

        <!-- Secondary / accent color -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccentDark</item>
        <item name="colorOnSecondary">@color/colorTextOnPrimary</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>

        <!-- FloatingActionButton color -->
        <item name="colorAccent">@color/colorAccent</item>

        <!-- BottomNavigationView -->
        <item name="bottomNavigationStyle">@style/BottomNavStyle</item>
    </style>

    <!-- Custom BottomNavigationView style -->
    <style name="BottomNavStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="backgroundTint">@color/colorSurface</item>
    </style>

    <!-- Card style used throughout the app -->
    <style name="AppCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
    </style>

    <!-- Section header text style -->
    <style name="SectionHeader">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="BudgetDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColor">#000000</item>
        <item name="colorAccent">#1E3A5F</item>
    </style>
</resources>
