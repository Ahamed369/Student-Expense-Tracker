<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_analytics.xml
    Layout for Function 3: Expense Analytics & Reports.
    Structure (scrollable):
      - Header
      - Filter radio group (Week / Month / All Time)
      - Stat cards (Total / Highest category / Daily avg)
      - PieChart (MPAndroidChart)
      - BarChart (MPAndroidChart)
      - Top 3 categories
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Header ──────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:padding="20dp"
            android:paddingTop="40dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Analytics"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── Filter Radio Group ──────────────────────────── -->
        <RadioGroup
            android:id="@+id/rg_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp"
            android:background="@color/colorSurface">

            <RadioButton
                android:id="@+id/rb_this_week"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_week"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_this_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_month"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="#000000"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_all_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_all"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- ── Stat Cards Row ─────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Total Spent -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/colorSurface">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💸 Total" android:textSize="11sp"
                        android:textColor="@color/colorTextSecondary" />
                    <TextView android:id="@+id/tv_analytics_total"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LKR 0" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/colorPrimary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Highest Category -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginHorizontal="3dp"
                app:cardCornerRadius="10dp" app:cardElevation="3dp"
                app:cardBackgroundColor="@color/colorSurface">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆 Top" android:textSize="11sp"
                        android:textColor="@color/colorTextSecondary" />
                    <TextView android:id="@+id/tv_analytics_highest"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="N/A" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/colorPrimary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Daily Average -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="6dp"
                app:cardCornerRadius="10dp" app:cardElevation="3dp"
                app:cardBackgroundColor="@color/colorSurface">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 Daily Avg" android:textSize="11sp"
                        android:textColor="@color/colorTextSecondary" />
                    <TextView android:id="@+id/tv_analytics_avg"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LKR 0" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/colorPrimary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ── PieChart ───────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/colorSurface">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spending by Category"
                    android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginBottom="8dp" />
                <!-- MPAndroidChart PieChart -->
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pie_chart"
                    android:layout_width="match_parent"
                    android:layout_height="260dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── BarChart ───────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/colorSurface">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Spending (Last 7 Days)"
                    android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginBottom="8dp" />
                <!-- MPAndroidChart BarChart -->
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/bar_chart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Top 3 Categories ──────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/colorSurface">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top Spending Categories"
                    android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginBottom="12dp" />
                <TextView android:id="@+id/tv_top1"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="—" android:textSize="14sp"
                    android:textColor="@color/colorTextPrimary"
                    android:padding="4dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginVertical="4dp" />
                <TextView android:id="@+id/tv_top2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="—" android:textSize="14sp"
                    android:textColor="@color/colorTextPrimary"
                    android:padding="4dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginVertical="4dp" />
                <TextView android:id="@+id/tv_top3"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="—" android:textSize="14sp"
                    android:textColor="@color/colorTextPrimary"
                    android:padding="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
