<?xml version="1.0" encoding="utf-8"?>
<!-- item_currency.xml — RecyclerView row for Currency Converter (Function 4)
     Shows: flag emoji, currency code/name, converted amount, exchange rate
     Author: Ahamed | Student Expense Tracker -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Flag Emoji Circle -->
        <TextView
            android:id="@+id/tv_currency_flag"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="26sp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#E8F5E9" />

        <!-- Currency Code + Country Name -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_currency_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USD"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />

            <TextView
                android:id="@+id/tv_currency_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="United States Dollar"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginTop="2dp" />

            <!-- Exchange Rate label -->
            <TextView
                android:id="@+id/tv_exchange_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 LKR = 0.0030 USD"
                android:textSize="11sp"
                android:textColor="@color/colorTextMuted"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <!-- Converted Amount (right-aligned) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_converted_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.00"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="converted"
                android:textSize="10sp"
                android:textColor="@color/colorTextMuted"
                android:gravity="end" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
