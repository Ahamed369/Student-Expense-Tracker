<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_add_expense.xml
    Dialog layout for adding a new expense (Function 1).
    Fields: Title, Amount, Category (Spinner), Date (Button), Notes.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:padding="20dp">

    <!-- Expense Title Label -->
    <TextView
        android:id="@+id/tv_label_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_expense_title"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/et_expense_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_max="488dp"
        android:hint="@string/hint_expense_title"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextSecondary"
        android:autofillHints="none"
        android:inputType="text"
        android:maxLines="1"
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_label_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Amount Label -->
    <TextView
        android:id="@+id/tv_label_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_amount"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/et_expense_title"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/et_expense_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_max="488dp"
        android:hint="@string/hint_amount"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextSecondary"
        android:autofillHints="none"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_label_amount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Category Spinner Label -->
    <TextView
        android:id="@+id/tv_label_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_category"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/et_expense_amount"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/sp_expense_category"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintWidth_max="488dp"
        android:background="@drawable/input_background"
        android:padding="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_label_category"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Date Picker Label -->
    <TextView
        android:id="@+id/tv_label_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_date"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/sp_expense_category"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_pick_date"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:maxWidth="320dp"
        android:text="@string/btn_select_date"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_label_date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Notes Label -->
    <TextView
        android:id="@+id/tv_label_notes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_notes"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/btn_pick_date"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/et_expense_notes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_max="488dp"
        android:hint="@string/hint_notes"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextSecondary"
        android:autofillHints="none"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4"
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_label_notes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
